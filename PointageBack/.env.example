# ==========================================
# Configuration Environnement - Pointage Backend (Exemple)
# ==========================================

# Port d'écoute du serveur
SERVER_PORT=8080

# Base de données PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pointage_db
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_SSLMODE=prefer

# Paramètres JWT / Sécurité (clé cryptographique 512-bit HMAC-SHA512)
JWT_SECRET=your_jwt_secret_key_minimum_64_characters_long_for_security_compliance
JWT_EXPIRATION_HOURS=24

# Origine Frontend autorisée (CORS)
FRONTEND_URL=http://localhost:4200
